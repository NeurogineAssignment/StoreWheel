<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ProductPageFragment">

    <fragment
        android:id="@+id/ProductPageFragment"
        android:name="com.example.storewheel.ProductPage"
        android:label="@string/product_page_label"
        tools:layout="@layout/fragment_product_page">

        <action
            android:id="@+id/action_ProductPageFragment_to_ProductDetailsFragment"
            app:destination="@id/ProductDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/ProductDetailsFragment"
        android:name="com.example.storewheel.ProductDetails"
        android:label="@string/product_details_label"
        tools:layout="@layout/fragment_product_details">

        <action
            android:id="@+id/action_ProductDetailsFragment_to_ProductPageFragment"
            app:destination="@id/ProductPageFragment" />
    </fragment>
</navigation>