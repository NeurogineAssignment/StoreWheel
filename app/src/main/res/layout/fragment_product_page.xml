<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".features.products.ProductPage">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:materialThemeOverlay="@style/ThemeOverlay.Material3Expressive.AppBarWithSearch"
        app:statusBarForeground="?attr/colorSurface"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/baseline_menu_24"
            app:menu="@menu/product_menu">

            <com.google.android.material.search.SearchBar
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_product">

            </com.google.android.material.search.SearchBar>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/error_state"
        layout="@layout/view_error_dialog"
        android:visibility="gone" />


    <com.google.android.material.search.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@id/searchBar">

        <include
            android:id="@+id/filteredProductsListContainer"
            layout="@layout/view_products_list" />
    </com.google.android.material.search.SearchView>

    <include
        android:id="@+id/productsListContainer"
        layout="@layout/view_products_list" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>